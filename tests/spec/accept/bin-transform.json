{
  "data": { "values": [
    { "amount": 1.0 }, { "amount": 2.0 }, { "amount": 2.5 },
    { "amount": 3.0 }, { "amount": 9.0 }, { "amount": 9.5 }
  ]},
  "transform": [
    { "bin": true, "field": "amount", "as": ["low", "high"] },
    { "aggregate": [{ "op": "count", "as": "n" }], "groupby": ["low"] }
  ],
  "mark": "bar",
  "encoding": { "x": { "field": "low", "scale": { "type": "band" } }, "y": { "field": "n" } }
}
